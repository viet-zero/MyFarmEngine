{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "phase1-debug",
      "displayName": "Phase 1 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/phase1-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "phase1-release",
      "inherits": "phase1-debug",
      "displayName": "Phase 1 Release",
      "binaryDir": "${sourceDir}/out/build/phase1-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "phase2-debug",
      "inherits": "phase1-debug",
      "displayName": "Phase 2 Debug",
      "binaryDir": "${sourceDir}/out/build/phase2-debug"
    },
    {
      "name": "phase2-release",
      "inherits": "phase1-release",
      "displayName": "Phase 2 Release",
      "binaryDir": "${sourceDir}/out/build/phase2-release"
    },
    {
      "name": "phase-a-debug",
      "inherits": "phase2-debug",
      "displayName": "Gameplay10 Phase A Debug",
      "binaryDir": "${sourceDir}/out/build/phase-a-debug",
      "cacheVariables": { "MYFARM_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "phase-a-release",
      "inherits": "phase2-release",
      "displayName": "Gameplay10 Phase A Release",
      "binaryDir": "${sourceDir}/out/build/phase-a-release",
      "cacheVariables": { "MYFARM_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "phase-a-asan",
      "inherits": "phase-a-release",
      "binaryDir": "${sourceDir}/out/build/phase-a-asan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "MYFARM_ENABLE_ASAN": "ON" }
    },
    {
      "name": "phase-b-debug",
      "inherits": "phase-a-debug",
      "displayName": "Gameplay10 Phase B Debug",
      "binaryDir": "${sourceDir}/out/build/phase-b-debug"
    },
    {
      "name": "phase-b-release",
      "inherits": "phase-a-release",
      "displayName": "Gameplay10 Phase B Release",
      "binaryDir": "${sourceDir}/out/build/phase-b-release"
    },
    {
      "name": "phase-b-asan",
      "inherits": "phase-a-asan",
      "displayName": "Gameplay10 Phase B ASan CPU",
      "binaryDir": "${sourceDir}/out/build/phase-b-asan"
    },
    {
      "name": "phase-c-debug",
      "inherits": "phase-b-debug",
      "displayName": "Gameplay10 Phase C Debug",
      "binaryDir": "${sourceDir}/out/build/phase-c-debug"
    },
    {
      "name": "phase-c-release",
      "inherits": "phase-b-release",
      "displayName": "Gameplay10 Phase C Release",
      "binaryDir": "${sourceDir}/out/build/phase-c-release"
    },
    {
      "name": "phase-c-asan",
      "inherits": "phase-b-asan",
      "displayName": "Gameplay10 Phase C ASan CPU",
      "binaryDir": "${sourceDir}/out/build/phase-c-asan"
    }
  ],
  "buildPresets": [
    { "name": "phase1-debug", "configurePreset": "phase1-debug", "jobs": 4 },
    { "name": "phase1-release", "configurePreset": "phase1-release", "jobs": 4 },
    { "name": "phase2-debug", "configurePreset": "phase2-debug", "jobs": 4 },
    { "name": "phase2-release", "configurePreset": "phase2-release", "jobs": 4 },
    { "name": "phase-a-debug", "configurePreset": "phase-a-debug", "jobs": 4 },
    { "name": "phase-a-release", "configurePreset": "phase-a-release", "jobs": 4 },
    { "name": "phase-a-asan", "configurePreset": "phase-a-asan", "jobs": 4, "targets": ["AssetPipelineTests", "AssetAudit"] },
    { "name": "phase-b-debug", "configurePreset": "phase-b-debug", "jobs": 4 },
    { "name": "phase-b-release", "configurePreset": "phase-b-release", "jobs": 4 },
    { "name": "phase-b-asan", "configurePreset": "phase-b-asan", "jobs": 4, "targets": ["AssetPipelineTests", "AssetAudit", "EngineAnimatorTests", "GameplayVisualTests"] },
    { "name": "phase-c-debug", "configurePreset": "phase-c-debug", "jobs": 4 },
    { "name": "phase-c-release", "configurePreset": "phase-c-release", "jobs": 4 },
    { "name": "phase-c-asan", "configurePreset": "phase-c-asan", "jobs": 4, "targets": ["AssetPipelineTests", "AssetAudit", "EngineAnimatorTests", "GameplayVisualTests", "GameplayWorldTests"] }
  ],
  "testPresets": [
    { "name": "phase1-debug", "configurePreset": "phase1-debug", "output": { "outputOnFailure": true } },
    { "name": "phase1-release", "configurePreset": "phase1-release", "output": { "outputOnFailure": true } },
    { "name": "phase2-debug", "configurePreset": "phase2-debug", "output": { "outputOnFailure": true } },
    { "name": "phase2-release", "configurePreset": "phase2-release", "output": { "outputOnFailure": true } },
    { "name": "phase-a-debug", "configurePreset": "phase-a-debug", "output": { "outputOnFailure": true } },
    { "name": "phase-a-release", "configurePreset": "phase-a-release", "output": { "outputOnFailure": true } },
    { "name": "phase-a-asan", "configurePreset": "phase-a-asan", "output": { "outputOnFailure": true }, "filter": { "include": { "name": "^assets\\.(validation|catalog)$" } } },
    { "name": "phase-b-debug", "configurePreset": "phase-b-debug", "output": { "outputOnFailure": true } },
    { "name": "phase-b-release", "configurePreset": "phase-b-release", "output": { "outputOnFailure": true } },
    { "name": "phase-b-asan", "configurePreset": "phase-b-asan", "output": { "outputOnFailure": true }, "filter": { "include": { "name": "^(assets\\.(validation|catalog)|engine\\.animator|gameplay\\.visuals)$" } } },
    { "name": "phase-c-debug", "configurePreset": "phase-c-debug", "output": { "outputOnFailure": true } },
    { "name": "phase-c-release", "configurePreset": "phase-c-release", "output": { "outputOnFailure": true } },
    { "name": "phase-c-asan", "configurePreset": "phase-c-asan", "output": { "outputOnFailure": true }, "filter": { "include": { "name": "^(assets\\.(validation|catalog)|engine\\.animator|gameplay\\.(visuals|world))$" } } }
  ]
}
